{
  "name": "codebay/toastr",
  "description": "A Laravel package for displaying toast notifications.",
  "keywords": [
    "codebay",
    "laravel",
    "toastr",
    "notification",
    "toast",
    "alerts",
    "messages",
    "flash messages",
    "pop-up",
    "user interface",
    "frontend"
  ],
  "type": "library",
  "license": "MIT",
  "Sellers": [
    {
      "name": "Toastr",
      "email": "support@toastr.com"
    }
  ],
  "require": {
    "php": ">=8.0",
    "illuminate/session": ">=8.0",
    "illuminate/support": ">=8.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.0"
  },
  "autoload": {
    "psr-4": {
      "Toastr\\": "src/"
    },
    "files": [
      "src/Helpers.php"
    ]
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "extra": {
    "laravel": {
      "providers": [
        "Toastr\\ToastrServiceProvider"
      ],
      "aliases": {
        "Toastr": "Toastr\\Facades\\ToastrFacade"
      }
    }
  },
  "config": {
    "sort-packages": true
  }
}
