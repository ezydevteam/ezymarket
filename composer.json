{
  "name": "laravel/laravel",
  "type": "project",
  "description": "The Laravel Framework.",
  "keywords": [
    "framework",
    "laravel"
  ],
  "license": "MIT",
  "repositories": [
    {
      "type": "path",
      "url": "./codebay/*",
      "options": {
        "symlink": true
      }
    }
  ],
  "require": {
    "php": "^8.2",
    "ably/ably-php": "^1.1",
    "anhskohbo/no-captcha": "^3.6",
    "aws/aws-sdk-php": "^3.295",
    "bacon/bacon-qr-code": "^3.0",
    "barryvdh/laravel-dompdf": "^3.1",
    "codebay/chunk": "@dev",
    "codebay/installer": "@dev",
    "codebay/toastr": "@dev",
    "cviebrock/eloquent-sluggable": "^11.0",
    "diglactic/laravel-breadcrumbs": "^9.0",
    "drewm/mailchimp-api": "^2.5",
    "ezyang/htmlpurifier": "^4.17",
    "flutterwavedev/flutterwave-v3": "^1.1",
    "guzzlehttp/guzzle": "^7.8",
    "hashids/hashids": "^5.0",
    "intervention/image": "3.0",
    "jenssegers/agent": "^2.6",
    "jenssegers/date": "^4.0",
    "laravel/framework": "^11.0",
    "laravel/reverb": "^1.5",
    "laravel/sanctum": "^4.0",
    "laravel/socialite": "^5.16",
    "laravel/tinker": "^2.10",
    "laravel/ui": "^4.5",
    "league/flysystem-aws-s3-v3": "^3.0",
    "livewire/livewire": "^3.0",
    "maatwebsite/excel": "^3.1",
    "mercadopago/dx-php": "^3.0",
    "mews/purifier": "^3.4",
    "paddlehq/paddle-php-sdk": "^1.1",
    "php-http/guzzle7-adapter": "^1.0",
    "pragmarx/google2fa-laravel": "^2.1",
    "propaganistas/laravel-disposable-email": "^2.4",
    "razorpay/razorpay": "^2.9",
    "reefki/laravel-device-detector": "^1.0",
    "rosell-dk/webp-convert": "^2.9",
    "socialiteproviders/envato": "^4.1",
    "socialiteproviders/microsoft": "^4.5",
    "socialiteproviders/vkontakte": "^5.0",
    "spatie/laravel-newsletter": "^5.1",
    "spatie/laravel-sitemap": "^7.2",
    "spatie/schema-org": "^3.23",
    "stripe/stripe-php": "^15.0",
    "trustip/trustip": "^1.1",
    "uddoktapay/laravel-sdk": "^1.0",
    "yoomoney/yookassa-sdk-php": "^3.5"
  },
  "require-dev": {
    "spatie/laravel-ignition": "^2.8",
    "fakerphp/faker": "^1.23",
    "laravel/pint": "^1.18",
    "laravel/sail": "^1.37",
    "mockery/mockery": "^1.6",
    "nunomaduro/collision": "^8.0",
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Factories\\": "database/factories/",
      "Database\\Seeders\\": "database/seeders/",
      "Codebay\\PayPal\\": "vendor/paypal-sdk",
      "Codebay\\NOWPayments\\": "vendor/nowpayments"
    },
    "files": [
      "app/Helpers/Core.php",
      "app/Helpers/Theme.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover --ansi"
    ],
    "post-update-cmd": [
      "@php artisan vendor:publish --tag=laravel-assets --ansi"
    ],
    "post-root-package-install": [
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
    ],
    "post-create-project-cmd": [
      "@php artisan key:generate --ansi"
    ]
  },
  "extra": {
    "laravel": {
      "dont-discover": []
    }
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "allow-plugins": {
      "php-http/discovery": true
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
