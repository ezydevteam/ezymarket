APP_NAME=ezymarket
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Asia/Dhaka

LOG_CHANNEL=stack
LOG_LEVEL=error

SYSTEM_ADMIN_PATH="admin"
SYSTEM_DEMO_MODE=false
SYSTEM_LICENSE_TYPE=2

INSTALL_REQUIREMENTS=0
INSTALL_FILE_PERMISSIONS=0
